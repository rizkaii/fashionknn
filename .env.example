# ============================================================
# FASHIONTRENDKNN — Environment Configuration Template
# ============================================================
# Salin file ini menjadi .env dan sesuaikan nilainya.
# JANGAN pernah commit file .env ke repository.
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_ENV=local
# APP_ENV: "local" untuk development, "production" untuk hosting

APP_DEBUG=true
# APP_DEBUG: true  → tampilkan error detail (development only)
#            false → sembunyikan error, catat ke log (production)

APP_URL=http://localhost/fashiontrendknn/public
# APP_URL: URL dasar aplikasi tanpa trailing slash
# Contoh production: https://domainkamu.com

APP_NAME=Fashion KNN

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fashion_knn
DB_USER=root
DB_PASS=
# DB_PASS: Kosong untuk Laragon default. Isi untuk production.

# ----------------------------------------------------------
# Session
# ----------------------------------------------------------
SESSION_LIFETIME=7200
# SESSION_LIFETIME: durasi session dalam detik (7200 = 2 jam)

SESSION_SECURE=false
# SESSION_SECURE: false untuk HTTP (development)
#                 true  untuk HTTPS (production — set otomatis jika APP_ENV=production)

SESSION_SAMESITE=Lax
# SESSION_SAMESITE: Lax | Strict | None

# ----------------------------------------------------------
# File Upload
# ----------------------------------------------------------
UPLOAD_MAX_SIZE_MB=5
# UPLOAD_MAX_SIZE_MB: batas ukuran file CSV dalam MB

# ----------------------------------------------------------
# Timezone
# ----------------------------------------------------------
APP_TIMEZONE=Asia/Jakarta

# ----------------------------------------------------------
# Catatan Production (ArenHost)
# ----------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://domainkamu.com
# DB_HOST=<isi dari control panel hosting>
# DB_PORT=3306
# DB_NAME=<nama_database_di_cpanel>
# DB_USER=<user_database_di_cpanel>
# DB_PASS=<password_database_yang_kuat>
# SESSION_SECURE=true
