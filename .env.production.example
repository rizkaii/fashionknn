APP_ENV=production
APP_DEBUG=false
APP_URL=https://DOMAIN_ANDA.COM
APP_NAME=Fashion KNN

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpses_tree3ql7ng_fashion_knn
DB_USER=cpses_tree3ql7ng_fashionuser
DB_PASS=ISI_PASSWORD_DATABASE_ANDA

SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_SAMESITE=Lax

UPLOAD_MAX_SIZE_MB=5

APP_TIMEZONE=Asia/Jakarta
