# Blokir akses langsung ke file upload
# Dan cegah eksekusi PHP di dalam folder ini
Options -Indexes -ExecCGI

# Blokir semua akses langsung
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Nonaktifkan PHP execution (double protection)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Blokir file PHP jika ada yang lolos
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|phar|cgi|pl|py|rb|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
